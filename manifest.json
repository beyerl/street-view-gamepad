{
  "manifest_version": 3,
  "name": "Street View Gamepad",
  "version": "1.9.0",
  "description": "Control Google Maps and Street View with a gamepad and hear ambient field recordings from nearby (radio aporee ::: maps) and spoken Wikipedia articles about the place.",
  "permissions": ["storage", "offscreen", "declarativeNetRequest"],
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.google.com/maps*",
        "*://www.google.de/maps*",
        "*://www.google.at/maps*",
        "*://www.google.ch/maps*",
        "*://www.google.co.uk/maps*",
        "*://maps.google.com/*",
        "*://maps.google.de/*"
      ],
      "js": ["dist/page.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://www.google.com/maps*",
        "*://www.google.de/maps*",
        "*://www.google.at/maps*",
        "*://www.google.ch/maps*",
        "*://www.google.co.uk/maps*",
        "*://maps.google.com/*",
        "*://maps.google.de/*"
      ],
      "js": ["dist/bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Street View Gamepad settings"
  },
  "host_permissions": [
    "https://aporee.org/*",
    "https://*.wikipedia.org/*",
    "https://commons.wikimedia.org/*",
    "https://huggingface.co/*",
    "https://*.hf.co/*",
    "https://cdn.jsdelivr.net/*"
  ]
}
