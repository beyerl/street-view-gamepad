{
  "manifest_version": 3,
  "name": "Street View Gamepad",
  "version": "1.1.0",
  "description": "Control Google Street View with a gamepad: ABXY to walk, D-pad to look around, shoulders to zoom, Start for fullscreen, Select to hide the search bar.",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.google.com/maps*",
        "*://www.google.de/maps*",
        "*://www.google.at/maps*",
        "*://www.google.ch/maps*",
        "*://www.google.co.uk/maps*",
        "*://maps.google.com/*",
        "*://maps.google.de/*"
      ],
      "js": [
        "inject.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://www.google.com/maps*",
        "*://www.google.de/maps*",
        "*://www.google.at/maps*",
        "*://www.google.ch/maps*",
        "*://www.google.co.uk/maps*",
        "*://maps.google.com/*",
        "*://maps.google.de/*"
      ],
      "js": [
        "settings.js",
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Street View Gamepad settings"
  }
}
